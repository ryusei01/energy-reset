{
  "expo": {
    "name": "Energy Reset",
    "slug": "energy-reset",
    "scheme": "energyreset",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-notifications"
    ],
    "android": {
      "package": "com.energyreset.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E7F6EE"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
